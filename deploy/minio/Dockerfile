# Reproducible source build of MinIO for the Businex storage service.
#
# Upstream:   https://github.com/minio/minio
# Tag:        RELEASE.2025-10-15T17-29-55Z
# Commit:     9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
# License:    AGPL-3.0-or-later (LICENSE shipped into the image)
#
# Registry images (Docker Hub minio/minio, quay.io/minio/minio) were not
# pullable in this environment, so the service is built from the official
# source at a pinned tag and commit instead. The build fails if the checked
# out commit does not match the pin below.

ARG GO_IMAGE=golang:1.25-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437
ARG RUNTIME_IMAGE=alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

FROM ${GO_IMAGE} AS build

ARG MINIO_TAG=RELEASE.2025-10-15T17-29-55Z
ARG MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
ARG MINIO_VERSION=2025-10-15T17:29:55Z

WORKDIR /src
RUN git clone --depth 1 --branch "${MINIO_TAG}" https://github.com/minio/minio . \
 && test "$(git rev-parse HEAD)" = "${MINIO_COMMIT}" \
 || (echo "minio source commit mismatch; refusing to build" >&2; exit 1)

# Same flags as the upstream Makefile build target, with release metadata
# generated by upstream buildscripts/gen-ldflags.go.
ENV CGO_ENABLED=0
RUN mkdir -p /out
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -tags kqueue -trimpath \
    --ldflags "$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go "${MINIO_VERSION}")" \
    -o /out/minio .

FROM ${RUNTIME_IMAGE}

RUN apk add --no-cache ca-certificates tzdata su-exec \
 && adduser -D -u 1000 -h /data minio \
 && mkdir -p /data /usr/share/licenses/minio \
 && chown -R minio:minio /data

COPY --from=build /out/minio /usr/bin/minio
COPY --from=build /src/LICENSE /usr/share/licenses/minio/LICENSE
COPY entrypoint.sh /usr/bin/entrypoint.sh
RUN chmod +x /usr/bin/entrypoint.sh

EXPOSE 9000 9001
VOLUME ["/data"]

ENTRYPOINT ["/usr/bin/entrypoint.sh"]
CMD ["server", "/data", "--console-address", ":9001"]
